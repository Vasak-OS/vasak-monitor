{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vasak-monitor",
  "version": "0.8.3",
  "identifier": "ar.net.vasak.vasak-monitor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vasak Monitor",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "desktopTemplate": "vasak-monitor.desktop.hbs",
        "depends": [
          "libc6",
          "libgcc-s1",
          "libcairo2",
          "libdbus-1-3",
          "libgdk-pixbuf-2.0-0",
          "libglib2.0-0t64",
          "libgtk-3-0t64",
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0",
          "libwebkit2gtk-4.1-0",
          "systemd",
          "pkexec",
          "coreutils",
          "mount",
          "iproute2",
          "desktop-file-utils",
          "hicolor-icon-theme"
        ],
        "files": {}
      }
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
